{
  "name": "PDF Sign",
  "short_name": "PDF Sign",
  "description": "Sign PDFs with your own signature and initials images, privately in your browser.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#eef0f3",
